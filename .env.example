# Copy to .env and fill in. Never commit .env.

# Which corpus/pipeline config to use.
CORPUS_CONFIG=config/uniswap.yaml

# LLM provider: groq | gemini | openrouter | ollama
# groq/openrouter/ollama go through the OpenAI-compatible adapter.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the provider's default endpoint.
LLM_BASE_URL=
# Model names for the chosen provider (see README "Models").
GENERATOR_MODEL=qwen/qwen3.8-27b
JUDGE_MODEL=openai/gpt-oss-120b
# Client-side throttle; keep below the provider's per-minute limit.
LLM_REQUESTS_PER_MINUTE=25

# Telegram bot (Phase 5).
TELEGRAM_BOT_TOKEN=
